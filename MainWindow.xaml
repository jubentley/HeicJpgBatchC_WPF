<!--AllowsTransparency="True"
    WindowStyle="None"-->
<Window 

    x:Class="HeicJpgBatchC_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HeicJpgBatchC_WPF"
        mc:Ignorable="d"
        Title="HeicJpgBatchC" Height="450" Width="600"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
    >
    <Window.Resources>

        <Color x:Key="ButtonShineGradient19">#00FFFFFF</Color>
        <Color x:Key="ButtonShineGradient5">#AA00FF00</Color>

        <Style TargetType="TextBlock">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF333333" BlurRadius="5" ShadowDepth="2" Opacity="0.8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF333333" BlurRadius="5" ShadowDepth="2" Opacity="0.8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF101820"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF182635" Offset="-0.1"/>
                        <GradientStop Color="#FF385875" Offset="0.5"/>
                        <GradientStop Color="#FF101820" Offset="1.3"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF333333" BlurRadius="5" ShadowDepth="2" Opacity="0.6"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid ClipToBounds="True">
                                <Rectangle x:Name="shine"
                                       Width="45"
                                       HorizontalAlignment="Left"
                                       IsHitTestVisible="False"
                                       Opacity="0">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{DynamicResource ButtonShineGradient19}" Offset="0.1"/>
                                            <GradientStop Color="{DynamicResource ButtonShineGradient5}" Offset="0.5"/>
                                            <GradientStop Color="{DynamicResource ButtonShineGradient19}" Offset="0.9"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform X="-45"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"
                                      Margin="{TemplateBinding Padding}">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect Color="#FF333333"
                                              BlurRadius="5"
                                              ShadowDepth="2"
                                              Opacity="0.8"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shine" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="shineAnimation">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="shine"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                From="-45" To="240"
                                                Duration="0:0:1.2"
                                                RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="shineAnimation"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF182635" Offset="0"/>
            <GradientStop Color="#FF385875" Offset="0.5"/>
            <GradientStop Color="#FF101820" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Label Content="HEIC to JPG Batch Converter" FontSize="30" Margin="10,0,10,0" Height="54" VerticalAlignment="Top">
        </Label>

        <TextBlock Text="Select a Folder, all Images with the .HEIC extension will be copied with the same quality and a .JPG file will be created and placed alongside it." FontSize="18" TextWrapping="Wrap" Margin="10,54,10,0" Height="123" VerticalAlignment="Top">
        </TextBlock>

        <Label x:Name="lblDirectory" FontSize="14" Margin="10,182,10,0" Content="C:\Example\Backup\FolderContaingHEICs" Height="35" VerticalAlignment="Top">
        </Label>

        <Button Click="BtnChangeDir" Content="Change Folder" HorizontalAlignment="Left" Margin="10,217,0,0" VerticalAlignment="Top" Width="240" Height="25" >
        </Button>

        <Button x:Name="btnExecute"  Click="BtnExecute" Content="Create JPG from HEIC" HorizontalAlignment="Left" Margin="10,247,0,0" VerticalAlignment="Top" Width="240" Height="25" />

        <Label x:Name="lblExecute" FontSize="14" Margin="10,277,10,0" Content="Ready to Convert" Height="35" VerticalAlignment="Top">
        </Label>

        <Button Click="BtnTerminate" Content="Exit" HorizontalAlignment="Left" Margin="10,312,0,0" VerticalAlignment="Top" Width="240" Height="25" >
            <Button.Resources>
                <Color x:Key="ButtonShineGradient19">#00DD0000</Color>
                <Color x:Key="ButtonShineGradient5">#AADD2222</Color>
            </Button.Resources>
        </Button>
 
        <Label FontSize="10" Margin="391,379,10,0" Content="justinbentley.dev v1.0 ©2026" Height="32" HorizontalContentAlignment="Right" VerticalContentAlignment="Bottom" VerticalAlignment="Top"/>

    </Grid>
</Window>

